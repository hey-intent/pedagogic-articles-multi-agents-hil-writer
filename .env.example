# API keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Model configuration (OpenRouter model names)
REASONING_MODEL=x-ai/grok-4.1-fast
WRITING_MODEL=anthropic/claude-sonnet-4.5

# OpenRouter base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT={here}
LANGSMITH_API_KEY={here}
